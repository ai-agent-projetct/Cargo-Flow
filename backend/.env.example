# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cargoflo_db
DB_USER=root
DB_PASSWORD=cargoflo123

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CLIENT_URL=http://localhost:3000

# Email (SMTP) - Update with real credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cargoflo.com

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# AI assistant, document extraction, and insights (Claude Opus 5).
# Get a key at https://console.anthropic.com — without it the AI features
# report "not configured" and the rest of the app is unaffected.
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini) — https://aistudio.google.com/apikey
# Whichever provider key is present wins; set AI_PROVIDER=gemini|claude to force one.
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
